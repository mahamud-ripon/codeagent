# --- Provider -------------------------------------------------------
# "openai" = Responses API (default, best tool-calling on OpenAI models)
# "chat"   = Chat Completions (any OpenAI-compatible endpoint: Ollama, Groq, ...)
# If OPENAI_BASE_URL is set, "chat" is assumed unless LLM_PROVIDER=openai.
LLM_PROVIDER=
OPENAI_BASE_URL=

# --- Credentials ----------------------------------------------------
# Not needed for local Ollama (any placeholder works); required for
# OpenAI / Groq / Gemini / OpenRouter.
OPENAI_API_KEY=your_key_here

# --- Model ----------------------------------------------------------
# OpenAI:      gpt-5.6-luna
# Ollama:      qwen2.5-coder:7b  (after `ollama pull qwen2.5-coder:7b`)
# Groq:        openai/gpt-oss-20b (verified live on free tier, Sep 2026)
# Gemini:      gemini-2.0-flash
# OpenRouter:  qwen/qwen3-coder:free
MODEL=gpt-5.6-luna
MAX_ITERATIONS=30
